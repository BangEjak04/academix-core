{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && concurrently -k \"swc src -d dist --strip-leading-paths --copy-files --watch\" \"node --env-file=.env --watch dist/main.js\"",
    "build": "swc src -d dist --strip-leading-paths --copy-files",
    "start": "node --env-file=.env dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "vitest run",
    "check-types": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/drizzle": "^0.0.1",
    "@nestjs/i18n": "^0.0.1",
    "@nestjs/platform-express": "^12.1.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^1.0.0-rc.4",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "chokidar": "^5.0.0"
  }
}
